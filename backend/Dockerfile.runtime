FROM eclipse-temurin:17-jre
WORKDIR /app

# 企业微信官方 CLI（机器人通道）：静态链接二进制，无需 Node 运行时。
# 版本与校验和锁定，下载失败即构建失败（不做静默降级）。
ARG WECOM_CLI_VERSION=1.3.0
ARG WECOM_CLI_SHA512_X64="kJOub+Gg+wa+K4f21pDyrLtaZK/cPOSrYkm1iST/PfrK66urNKHv7GIEtRUcD4WvKL7yxfyl+QwxyNsMixLAAA=="
ARG WECOM_CLI_SHA512_ARM64="t2Mww45xF9E2AEO7hWMKfsynLljfnn4ngVcDGljGIhm306wNBheMU7F6n/HNVwu8fNL76uPIH+eoYyL7EVxf+w=="

RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) pkg="cli-linux-x64"; expected="${WECOM_CLI_SHA512_X64}" ;; \
      arm64) pkg="cli-linux-arm64"; expected="${WECOM_CLI_SHA512_ARM64}" ;; \
      *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    url="https://registry.npmmirror.com/@wecom/${pkg}/-/${pkg}-${WECOM_CLI_VERSION}.tgz"; \
    fallback="https://registry.npmjs.org/@wecom/${pkg}/-/${pkg}-${WECOM_CLI_VERSION}.tgz"; \
    (curl -fsSL --retry 3 --retry-delay 2 "$url" -o /tmp/wecom-cli.tgz \
      || curl -fsSL --retry 3 --retry-delay 2 "$fallback" -o /tmp/wecom-cli.tgz); \
    actual="$(sha512sum /tmp/wecom-cli.tgz | cut -d' ' -f1 | xxd -r -p | base64 -w0)"; \
    [ "$actual" = "$expected" ] || { echo "wecom-cli checksum mismatch: $actual" >&2; exit 1; }; \
    mkdir -p /app/wecom-cli; \
    tar -xzf /tmp/wecom-cli.tgz -C /app/wecom-cli --strip-components=2 package/bin/wecom-cli; \
    chmod 755 /app/wecom-cli/wecom-cli; \
    rm -f /tmp/wecom-cli.tgz; \
    /app/wecom-cli/wecom-cli --version

RUN groupadd -r spring && useradd -r -g spring spring \
    && mkdir -p /data/wecom-cli/workspace \
    && chown -R spring:spring /data/wecom-cli
USER spring:spring

COPY target/*.jar app.jar

EXPOSE 8081

ENTRYPOINT ["sh", "-c", "exec java -Djava.security.egd=file:/dev/./urandom -Duser.timezone=${TZ:-Asia/Shanghai} -Dspring.profiles.active=${SPRING_PROFILES_ACTIVE:-prod} -jar app.jar"]
